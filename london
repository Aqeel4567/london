<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>London, Always</title>
<link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,300;0,400;1,300;1,400&family=DM+Sans:wght@300;400;500&display=swap" rel="stylesheet">
<style>
  *, *::before, *::after { margin: 0; padding: 0; box-sizing: border-box; }

  :root {
    --cream: #f5f0e8;
    --ink: #0e0d0b;
    --gold: #c8a96e;
    --fog: #b8b4ac;
    --deep: #1a1814;
    --mid: #2e2b25;
  }

  html { scroll-behavior: smooth; }

  body {
    background: var(--ink);
    color: var(--cream);
    font-family: 'DM Sans', sans-serif;
    overflow-x: hidden;
    cursor: none;
  }

  /* Custom cursor */
  .cursor {
    width: 12px; height: 12px;
    background: var(--gold);
    border-radius: 50%;
    position: fixed;
    pointer-events: none;
    z-index: 9999;
    transition: transform 0.15s ease, opacity 0.2s;
    transform: translate(-50%, -50%);
  }
  .cursor-ring {
    width: 40px; height: 40px;
    border: 1px solid rgba(200,169,110,0.4);
    border-radius: 50%;
    position: fixed;
    pointer-events: none;
    z-index: 9998;
    transform: translate(-50%, -50%);
    transition: transform 0.4s cubic-bezier(0.16,1,0.3,1), width 0.3s, height 0.3s, opacity 0.2s;
  }
  body.hovering .cursor { transform: translate(-50%,-50%) scale(2.5); background: var(--gold); }
  body.hovering .cursor-ring { width: 60px; height: 60px; opacity: 0.3; }

  /* Nav */
  nav {
    position: fixed; top: 0; left: 0; right: 0;
    z-index: 100;
    padding: 24px 48px;
    display: flex; justify-content: space-between; align-items: center;
    background: linear-gradient(to bottom, rgba(14,13,11,0.8), transparent);
    backdrop-filter: blur(0px);
    transition: backdrop-filter 0.4s, background 0.4s;
  }
  nav.scrolled { backdrop-filter: blur(20px); background: rgba(14,13,11,0.7); }
  .nav-logo {
    font-family: 'Cormorant Garamond', serif;
    font-size: 22px; font-weight: 300;
    letter-spacing: 0.15em;
    color: var(--cream);
    text-decoration: none;
  }
  .nav-links { display: flex; gap: 36px; list-style: none; }
  .nav-links a {
    color: var(--fog); font-size: 13px; letter-spacing: 0.08em;
    text-decoration: none; text-transform: uppercase;
    transition: color 0.3s;
  }
  .nav-links a:hover { color: var(--gold); }

  /* Hero */
  .hero {
    height: 100vh;
    position: relative;
    display: flex; flex-direction: column;
    align-items: center; justify-content: center;
    overflow: hidden;
  }

  .hero-bg {
    position: absolute; inset: 0;
    background:
      radial-gradient(ellipse 80% 60% at 50% 80%, rgba(200,169,110,0.07) 0%, transparent 70%),
      radial-gradient(ellipse 40% 40% at 20% 30%, rgba(200,169,110,0.04) 0%, transparent 60%),
      var(--ink);
  }

  /* London skyline SVG */
  .skyline {
    position: absolute;
    bottom: 0; left: 0; right: 0;
    width: 100%; height: auto;
    opacity: 0.18;
  }

  /* Thames reflection */
  .thames {
    position: absolute;
    bottom: 0; left: 0; right: 0;
    height: 120px;
    background: linear-gradient(to top, rgba(200,169,110,0.06), transparent);
  }

  .hero-content {
    position: relative; z-index: 2;
    text-align: center;
    padding: 0 24px;
  }

  .hero-eyebrow {
    font-size: 11px; letter-spacing: 0.3em;
    text-transform: uppercase;
    color: var(--gold);
    margin-bottom: 28px;
    opacity: 0;
    transform: translateY(20px);
    animation: fadeUp 1s 0.3s forwards;
  }

  .hero-title {
    font-family: 'Cormorant Garamond', serif;
    font-size: clamp(72px, 12vw, 160px);
    font-weight: 300;
    line-height: 0.9;
    letter-spacing: -0.02em;
    color: var(--cream);
    opacity: 0;
    transform: translateY(30px);
    animation: fadeUp 1.2s 0.5s forwards;
  }

  .hero-title em {
    font-style: italic;
    color: var(--gold);
  }

  .hero-sub {
    font-size: 16px; font-weight: 300;
    color: var(--fog);
    margin-top: 32px;
    letter-spacing: 0.04em;
    opacity: 0;
    transform: translateY(20px);
    animation: fadeUp 1s 0.9s forwards;
  }

  .hero-scroll {
    position: absolute; bottom: 48px;
    left: 50%; transform: translateX(-50%);
    display: flex; flex-direction: column; align-items: center;
    gap: 8px;
    opacity: 0;
    animation: fadeUp 1s 1.4s forwards;
  }
  .scroll-label { font-size: 10px; letter-spacing: 0.25em; text-transform: uppercase; color: var(--fog); }
  .scroll-line {
    width: 1px; height: 48px;
    background: linear-gradient(to bottom, var(--gold), transparent);
    animation: scrollPulse 2s ease-in-out infinite;
  }

  @keyframes fadeUp {
    to { opacity: 1; transform: translateY(0); }
  }
  @keyframes scrollPulse {
    0%, 100% { opacity: 0.3; }
    50% { opacity: 1; }
  }

  /* Sections */
  section {
    padding: 120px 48px;
    max-width: 1200px;
    margin: 0 auto;
  }

  /* Landmarks grid */
  .landmarks-intro {
    text-align: center;
    margin-bottom: 80px;
  }
  .section-label {
    font-size: 11px; letter-spacing: 0.3em; text-transform: uppercase;
    color: var(--gold); margin-bottom: 20px;
  }
  .section-title {
    font-family: 'Cormorant Garamond', serif;
    font-size: clamp(42px, 6vw, 72px);
    font-weight: 300;
    line-height: 1.05;
    color: var(--cream);
  }
  .section-title em { font-style: italic; color: var(--gold); }

  .landmarks-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 2px;
  }

  .landmark-card {
    position: relative;
    aspect-ratio: 3/4;
    overflow: hidden;
    cursor: none;
  }
  .landmark-card:first-child { grid-row: span 2; aspect-ratio: unset; }

  .landmark-illustration {
    width: 100%; height: 100%;
    display: flex; align-items: flex-end;
    justify-content: center;
    padding-bottom: 40px;
    background: var(--deep);
    transition: transform 0.7s cubic-bezier(0.16,1,0.3,1);
  }

  .landmark-card:hover .landmark-illustration { transform: scale(1.04); }

  .landmark-overlay {
    position: absolute; inset: 0;
    background: linear-gradient(to top, rgba(14,13,11,0.85) 0%, transparent 50%);
    transition: opacity 0.4s;
  }

  .landmark-info {
    position: absolute; bottom: 0; left: 0; right: 0;
    padding: 32px 28px;
    transform: translateY(8px);
    transition: transform 0.4s cubic-bezier(0.16,1,0.3,1);
  }
  .landmark-card:hover .landmark-info { transform: translateY(0); }

  .landmark-name {
    font-family: 'Cormorant Garamond', serif;
    font-size: 28px; font-weight: 300;
    color: var(--cream);
    margin-bottom: 6px;
  }
  .landmark-desc {
    font-size: 13px; color: var(--fog);
    line-height: 1.5;
    opacity: 0;
    transform: translateY(8px);
    transition: opacity 0.3s 0.05s, transform 0.3s 0.05s;
  }
  .landmark-card:hover .landmark-desc { opacity: 1; transform: translateY(0); }

  .landmark-number {
    position: absolute; top: 24px; right: 24px;
    font-family: 'Cormorant Garamond', serif;
    font-size: 13px; color: var(--gold);
    letter-spacing: 0.1em;
    opacity: 0.6;
  }

  /* Quote section */
  .quote-section {
    max-width: 1200px;
    margin: 0 auto;
    padding: 100px 48px;
    text-align: center;
    border-top: 1px solid rgba(200,169,110,0.15);
    border-bottom: 1px solid rgba(200,169,110,0.15);
  }
  .quote-mark {
    font-family: 'Cormorant Garamond', serif;
    font-size: 120px;
    line-height: 0.5;
    color: var(--gold);
    opacity: 0.3;
    display: block;
    margin-bottom: 24px;
  }
  .quote-text {
    font-family: 'Cormorant Garamond', serif;
    font-size: clamp(28px, 4vw, 52px);
    font-weight: 300;
    font-style: italic;
    line-height: 1.3;
    color: var(--cream);
    max-width: 900px;
    margin: 0 auto 28px;
  }
  .quote-attr {
    font-size: 13px; letter-spacing: 0.2em;
    text-transform: uppercase; color: var(--gold);
  }

  /* Seasons section */
  .seasons-section {
    max-width: 1200px; margin: 0 auto;
    padding: 120px 48px;
  }
  .seasons-tabs {
    display: flex; gap: 0;
    margin-bottom: 64px;
    border-bottom: 1px solid rgba(200,169,110,0.15);
  }
  .season-tab {
    padding: 16px 32px;
    font-size: 13px; letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--fog);
    background: none; border: none;
    cursor: none;
    position: relative;
    transition: color 0.3s;
  }
  .season-tab::after {
    content: '';
    position: absolute; bottom: -1px; left: 0; right: 0; height: 1px;
    background: var(--gold);
    transform: scaleX(0);
    transition: transform 0.4s cubic-bezier(0.16,1,0.3,1);
  }
  .season-tab.active { color: var(--gold); }
  .season-tab.active::after { transform: scaleX(1); }

  .season-content { display: none; }
  .season-content.active { display: grid; grid-template-columns: 1fr 1fr; gap: 80px; align-items: center; }

  .season-visual {
    height: 480px;
    background: var(--deep);
    border-radius: 2px;
    display: flex; align-items: center; justify-content: center;
    overflow: hidden;
    position: relative;
  }

  .season-text h3 {
    font-family: 'Cormorant Garamond', serif;
    font-size: 52px; font-weight: 300;
    color: var(--cream); margin-bottom: 24px;
    line-height: 1;
  }
  .season-text p {
    font-size: 16px; font-weight: 300;
    color: var(--fog); line-height: 1.8;
    margin-bottom: 20px;
  }
  .season-highlights {
    list-style: none; margin-top: 32px;
  }
  .season-highlights li {
    font-size: 14px; color: var(--fog);
    padding: 12px 0;
    border-bottom: 1px solid rgba(200,169,110,0.1);
    display: flex; align-items: center; gap: 16px;
  }
  .season-highlights li::before {
    content: '';
    width: 24px; height: 1px;
    background: var(--gold);
    flex-shrink: 0;
  }

  /* Hidden gem section */
  .gems-section {
    max-width: 1200px; margin: 0 auto;
    padding: 120px 48px;
  }
  .gems-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 32px;
    margin-top: 64px;
  }
  .gem-card {
    background: var(--deep);
    padding: 40px;
    position: relative;
    overflow: hidden;
    transition: transform 0.4s cubic-bezier(0.16,1,0.3,1);
  }
  .gem-card:hover { transform: translateY(-4px); }
  .gem-card::before {
    content: '';
    position: absolute; top: 0; left: 0;
    width: 1px; height: 0;
    background: var(--gold);
    transition: height 0.5s cubic-bezier(0.16,1,0.3,1);
  }
  .gem-card:hover::before { height: 100%; }
  .gem-icon { font-size: 32px; margin-bottom: 24px; }
  .gem-name {
    font-family: 'Cormorant Garamond', serif;
    font-size: 28px; font-weight: 300;
    color: var(--cream); margin-bottom: 12px;
  }
  .gem-text { font-size: 14px; color: var(--fog); line-height: 1.75; }
  .gem-tag {
    display: inline-block; margin-top: 20px;
    font-size: 10px; letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--gold);
    border: 1px solid rgba(200,169,110,0.3);
    padding: 6px 14px;
  }

  /* Message section */
  .message-section {
    max-width: 800px; margin: 0 auto;
    padding: 120px 48px;
    text-align: center;
  }
  .message-title {
    font-family: 'Cormorant Garamond', serif;
    font-size: clamp(48px, 7vw, 88px);
    font-weight: 300;
    line-height: 1;
    color: var(--cream);
    margin-bottom: 32px;
  }
  .message-title em { font-style: italic; color: var(--gold); }
  .message-body {
    font-size: 18px; font-weight: 300;
    color: var(--fog); line-height: 1.9;
    max-width: 600px; margin: 0 auto 48px;
  }
  .message-heart {
    font-size: 48px;
    animation: heartbeat 2s ease-in-out infinite;
    display: inline-block;
  }
  @keyframes heartbeat {
    0%, 100% { transform: scale(1); }
    50% { transform: scale(1.15); }
  }

  /* Footer */
  footer {
    border-top: 1px solid rgba(200,169,110,0.1);
    padding: 48px;
    text-align: center;
    font-size: 12px; color: rgba(184,180,172,0.4);
    letter-spacing: 0.1em;
  }

  /* Scroll reveal */
  .reveal {
    opacity: 0; transform: translateY(40px);
    transition: opacity 0.9s cubic-bezier(0.16,1,0.3,1), transform 0.9s cubic-bezier(0.16,1,0.3,1);
  }
  .reveal.visible { opacity: 1; transform: translateY(0); }
  .reveal-delay-1 { transition-delay: 0.1s; }
  .reveal-delay-2 { transition-delay: 0.2s; }
  .reveal-delay-3 { transition-delay: 0.3s; }
  .reveal-delay-4 { transition-delay: 0.4s; }

  @media (max-width: 768px) {
    nav { padding: 20px 24px; }
    .nav-links { display: none; }
    section, .quote-section, .seasons-section, .gems-section, .message-section { padding: 80px 24px; }
    .landmarks-grid { grid-template-columns: 1fr; }
    .landmark-card:first-child { grid-row: span 1; aspect-ratio: 3/4; }
    .season-content.active { grid-template-columns: 1fr; }
    .gems-grid { grid-template-columns: 1fr; }
  }
</style>
</head>
<body>

<div class="cursor" id="cursor"></div>
<div class="cursor-ring" id="cursor-ring"></div>

<!-- Nav -->
<nav id="nav">
  <a href="#" class="nav-logo">London</a>
  <ul class="nav-links">
    <li><a href="#landmarks">Landmarks</a></li>
    <li><a href="#seasons">Seasons</a></li>
    <li><a href="#hidden">Hidden</a></li>
    <li><a href="#message">A Note</a></li>
  </ul>
</nav>

<!-- Hero -->
<div class="hero">
  <div class="hero-bg"></div>

  <!-- London skyline illustration -->
  <svg class="skyline" viewBox="0 0 1440 340" fill="none" xmlns="http://www.w3.org/2000/svg">
    <!-- Big Ben / Elizabeth Tower -->
    <rect x="200" y="60" width="24" height="280" fill="#c8a96e"/>
    <rect x="195" y="50" width="34" height="20" fill="#c8a96e"/>
    <polygon points="212,20 195,50 229,50" fill="#c8a96e"/>
    <rect x="205" y="110" width="4" height="40" fill="#0e0d0b"/>
    <rect x="215" y="110" width="4" height="40" fill="#0e0d0b"/>
    <!-- Westminster Palace -->
    <rect x="100" y="180" width="160" height="160" fill="#c8a96e"/>
    <rect x="108" y="190" width="12" height="150" fill="#0e0d0b" opacity="0.3"/>
    <rect x="128" y="190" width="12" height="150" fill="#0e0d0b" opacity="0.3"/>
    <rect x="148" y="190" width="12" height="150" fill="#0e0d0b" opacity="0.3"/>
    <rect x="168" y="190" width="12" height="150" fill="#0e0d0b" opacity="0.3"/>
    <rect x="188" y="190" width="12" height="150" fill="#0e0d0b" opacity="0.3"/>
    <rect x="208" y="190" width="12" height="150" fill="#0e0d0b" opacity="0.3"/>
    <rect x="228" y="190" width="12" height="150" fill="#0e0d0b" opacity="0.3"/>
    <!-- Tower Bridge -->
    <rect x="650" y="140" width="16" height="200" fill="#c8a96e"/>
    <rect x="774" y="140" width="16" height="200" fill="#c8a96e"/>
    <rect x="645" y="130" width="26" height="20" fill="#c8a96e"/>
    <rect x="769" y="130" width="26" height="20" fill="#c8a96e"/>
    <polygon points="658,80 645,130 671,130" fill="#c8a96e"/>
    <polygon points="782,80 769,130 795,130" fill="#c8a96e"/>
    <line x1="666" y1="100" x2="784" y2="100" stroke="#c8a96e" stroke-width="2"/>
    <rect x="666" y="220" width="108" height="8" fill="#c8a96e"/>
    <!-- The Shard -->
    <polygon points="950,0 930,340 970,340" fill="#c8a96e"/>
    <!-- Gherkin -->
    <ellipse cx="1100" cy="220" rx="18" ry="80" fill="#c8a96e"/>
    <polygon points="1100,130 1082,160 1118,160" fill="#c8a96e"/>
    <!-- St Paul's dome -->
    <ellipse cx="490" cy="160" rx="60" ry="40" fill="#c8a96e"/>
    <rect x="450" y="190" width="80" height="150" fill="#c8a96e"/>
    <rect x="455" y="200" width="10" height="140" fill="#0e0d0b" opacity="0.3"/>
    <rect x="475" y="200" width="10" height="140" fill="#0e0d0b" opacity="0.3"/>
    <rect x="495" y="200" width="10" height="140" fill="#0e0d0b" opacity="0.3"/>
    <rect x="515" y="200" width="10" height="140" fill="#0e0d0b" opacity="0.3"/>
    <line x1="490" y1="110" x2="490" y2="0" stroke="#c8a96e" stroke-width="2"/>
    <!-- Thames -->
    <rect x="0" y="310" width="1440" height="30" fill="#c8a96e" opacity="0.2"/>
  </svg>

  <div class="hero-content">
    <p class="hero-eyebrow">51.5074° N, 0.1278° W</p>
    <h1 class="hero-title">Lon<em>don</em></h1>
    <p class="hero-sub">A city that lives in fog and fire, in rain and gold</p>
  </div>

  <div class="hero-scroll">
    <span class="scroll-label">Explore</span>
    <div class="scroll-line"></div>
  </div>
</div>

<!-- Landmarks -->
<section id="landmarks">
  <div class="landmarks-intro reveal">
    <p class="section-label">Iconic Places</p>
    <h2 class="section-title">The city's<br>great <em>monuments</em></h2>
  </div>

  <div class="landmarks-grid">
    <!-- Big Ben -->
    <div class="landmark-card reveal">
      <div class="landmark-illustration" style="background: linear-gradient(160deg, #1a1814 0%, #0e0d0b 100%);">
        <svg width="200" height="380" viewBox="0 0 200 380" fill="none">
          <rect x="88" y="40" width="24" height="300" fill="#c8a96e" opacity="0.9"/>
          <rect x="82" y="28" width="36" height="20" fill="#c8a96e" opacity="0.9"/>
          <polygon points="100,2 82,28 118,28" fill="#c8a96e" opacity="0.9"/>
          <circle cx="100" cy="120" r="14" fill="none" stroke="#c8a96e" stroke-width="1.5" opacity="0.6"/>
          <rect x="92" y="168" width="4" height="48" fill="#0e0d0b"/>
          <rect x="104" y="168" width="4" height="48" fill="#0e0d0b"/>
          <rect x="70" y="340" width="60" height="40" fill="#c8a96e" opacity="0.3"/>
          <line x1="40" y1="375" x2="160" y2="375" stroke="#c8a96e" stroke-width="1" opacity="0.3"/>
        </svg>
      </div>
      <div class="landmark-overlay"></div>
      <div class="landmark-info">
        <p class="landmark-name">Big Ben</p>
        <p class="landmark-desc">The great clock tower of Westminster — London's most recognised silhouette, chiming since 1859.</p>
      </div>
      <span class="landmark-number">01</span>
    </div>

    <!-- Tower Bridge -->
    <div class="landmark-card reveal reveal-delay-1">
      <div class="landmark-illustration" style="background: linear-gradient(160deg, #1c1810 0%, #0e0d0b 100%);">
        <svg width="180" height="200" viewBox="0 0 180 200" fill="none">
          <rect x="20" y="40" width="14" height="160" fill="#c8a96e" opacity="0.8"/>
          <rect x="146" y="40" width="14" height="160" fill="#c8a96e" opacity="0.8"/>
          <rect x="15" y="30" width="24" height="16" fill="#c8a96e" opacity="0.8"/>
          <rect x="141" y="30" width="24" height="16" fill="#c8a96e" opacity="0.8"/>
          <polygon points="27,4 15,30 39,30" fill="#c8a96e" opacity="0.8"/>
          <polygon points="153,4 141,30 165,30" fill="#c8a96e" opacity="0.8"/>
          <line x1="27" y1="16" x2="153" y2="16" stroke="#c8a96e" stroke-width="1.5" opacity="0.5"/>
          <rect x="34" y="130" width="112" height="6" fill="#c8a96e" opacity="0.5"/>
          <path d="M34 130 Q90 110 146 130" stroke="#c8a96e" stroke-width="1" fill="none" opacity="0.4"/>
          <rect x="0" y="185" width="180" height="15" fill="#c8a96e" opacity="0.1"/>
        </svg>
      </div>
      <div class="landmark-overlay"></div>
      <div class="landmark-info">
        <p class="landmark-name">Tower Bridge</p>
        <p class="landmark-desc">A Victorian masterpiece spanning the Thames — still raises its bascules for tall ships today.</p>
      </div>
      <span class="landmark-number">02</span>
    </div>

    <!-- St Paul's -->
    <div class="landmark-card reveal reveal-delay-2">
      <div class="landmark-illustration" style="background: linear-gradient(160deg, #151210 0%, #0e0d0b 100%);">
        <svg width="180" height="200" viewBox="0 0 180 200" fill="none">
          <ellipse cx="90" cy="80" rx="55" ry="36" fill="#c8a96e" opacity="0.7"/>
          <rect x="44" y="108" width="92" height="92" fill="#c8a96e" opacity="0.7"/>
          <rect x="52" y="116" width="10" height="84" fill="#0e0d0b" opacity="0.3"/>
          <rect x="72" y="116" width="10" height="84" fill="#0e0d0b" opacity="0.3"/>
          <rect x="92" y="116" width="10" height="84" fill="#0e0d0b" opacity="0.3"/>
          <rect x="112" y="116" width="10" height="84" fill="#0e0d0b" opacity="0.3"/>
